---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { NAME, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="mx-auto max-w-2xl px-4">
			<Header />
			<main class="flex flex-col items-center justify-center py-16 text-center">
				<img
					src="https://www.gravatar.com/avatar/988420433ed98c010c2dcd531800f711?s=240&d=mp"
					alt={NAME}
					class="mb-6 size-60 rounded-full"
					width="240"
					height="240"
				/>
				<h1 class="mb-6 text-3xl font-bold text-text-heading">{NAME}</h1>
				<ul class="flex items-center gap-6">
					<li>
						<a
							href="https://github.com/attamusc/"
							aria-label="GitHub"
							class="text-text-muted hover:text-accent transition-colors"
						>
							<svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
							</svg>
						</a>
					</li>
					<li>
						<a
							href="https://social.lol/@attamusc"
							aria-label="Mastodon"
							rel="me"
							class="text-text-muted hover:text-accent transition-colors"
						>
							<svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054 19.648 19.648 0 0 0 4.168.507h.313c1.687 0 3.382-.1 5.04-.479 1.808-.413 3.385-1.275 3.685-3.645.045-.357.09-.714.102-1.078.035-1.084.044-2.17-.015-3.253Z" />
								<path d="M19.903 7.515v5.84h-2.317v-5.67c0-1.193-.501-1.8-1.507-1.8-1.11 0-1.666.72-1.666 2.142v3.1h-2.302v-3.1c0-1.423-.556-2.142-1.666-2.142-1.006 0-1.507.607-1.507 1.8v5.67H6.621v-5.84c0-1.192.304-2.14.913-2.843.628-.703 1.451-1.064 2.472-1.064 1.18 0 2.074.453 2.672 1.36l.576.966.576-.966c.598-.907 1.492-1.36 2.672-1.36 1.021 0 1.844.36 2.472 1.064.609.703.913 1.65.913 2.843h-.014Z" />
							</svg>
						</a>
					</li>
					<li>
						<a
							href="https://linkedin.com/in/seanpdunn"
							aria-label="LinkedIn"
							class="text-text-muted hover:text-accent transition-colors"
						>
							<svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
							</svg>
						</a>
					</li>
				</ul>
			</main>
			<Footer />
		</div>
	</body>
</html>
